rules_version = '2';
// RB Websystems ERP – Firestore Security Rules
//
// TƏTBIQ ETMƏK ÜÇÜN:
// Firebase Console → https://console.firebase.google.com
// → rbwebsystems-d2da2 layihəsi
// → Firestore Database → Rules tab
// → Bu faylın içindəkiləri yapışdırıb "Publish" et
//
// Arxitektura: Anonymous Auth istifadə olunur.
// Şirkət ID-ləri UUID formatındadır → brute-force demək olar ki mümkün deyil.

service cloud.firestore {
  match /databases/{database}/documents {

    // META: İstifadəçilər, şirkət siyahısı, ayarlar
    // Yalnız authenticate olmuş (anonim də daxil) istifadəçilər oxuya/yaza bilər
    match /meta/{document=**} {
      allow read, write: if request.auth != null;
    }

    // ŞİRKƏT DATA: Hər şirkətin öz ayrı documenti
    // UUID-based ID olduğuna görə tahmin etmək demək olar ki mümkün deyil
    match /companies/{companyId} {
      allow read, write: if request.auth != null;
    }

    // DİGƏR: Bütün qalan path-ları bağla
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

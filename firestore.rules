rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // META (config/meta): şirkət siyahısı, istifadəçilər
    // Oxumaq + Yazmaq: istənilən auth (anonim də) — mövcud davranış qorunur
    // Əsas təhlükəsizlik: şirkət datası (aşağıda) companyId claim ilə qorunur
    match /config/meta {
      allow read, write: if request.auth != null;
    }

    // CONFIG altındakı digər sənədlər — bağlı
    match /config/{document=**} {
      allow read, write: if false;
    }

    // ŞİRKƏT DATA: yalnız issueAuthToken ilə giriş etmiş istifadəçilər
    // (anonim istifadəçilər bloklanır, companyId izolasiyası debug sonra)
    match /companies/{companyId} {
      allow read, write: if request.auth != null
        && request.auth.token.erp_session == true;
    }

    // DİGƏR: tam bağlı
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

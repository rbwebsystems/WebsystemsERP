rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // META (config/meta): yalnız giriş etmiş istifadəçilər
    // Login artıq Cloud Function vasitəsilə (Admin SDK ilə oxuyur)
    match /config/meta {
      allow read, write: if request.auth != null
        && request.auth.token.erp_session == true;
    }

    // CONFIG altındakı digər sənədlər — bağlı
    match /config/{document=**} {
      allow read, write: if false;
    }

    // ŞİRKƏT DATA: tam izolasiya
    match /companies/{companyId} {
      allow read, write: if request.auth != null
        && request.auth.token.erp_session == true
        && (
          request.auth.token.companyId == companyId
          || request.auth.token.role == 'developer'
        );
    }

    // DİGƏR: tam bağlı
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

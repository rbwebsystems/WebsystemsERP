rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // META (config/meta): şirkət siyahısı, istifadəçilər
    // Oxumaq: istənilən auth (anonim də) — login səhifəsi üçün lazımdır
    // Yazmaq: yalnız giriş etmiş (erp_session) istifadəçilər
    match /config/meta {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.token.erp_session == true;
    }

    // CONFIG altındakı digər sənədlər — bağlı
    match /config/{document=**} {
      allow read, write: if false;
    }

    // ŞİRKƏT DATA: yalnız öz companyId-si olan istifadəçi
    match /companies/{companyId} {
      allow read, write: if request.auth != null
        && (
          request.auth.token.companyId == companyId
          || request.auth.token.role == 'developer'
        );
    }

    // DİGƏR: tam bağlı
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

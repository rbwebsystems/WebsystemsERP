rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // META (config/meta):
    // Oxumaq: giriş etmiş istifadəçilər
    // Yazmaq: developer və ya admin (istifadəçi/şirkət idarəetməsi)
    match /config/meta {
      allow read:  if request.auth != null
        && request.auth.token.erp_session == true;
      allow write: if request.auth != null
        && request.auth.token.erp_session == true
        && (
          request.auth.token.role == 'developer'
          || request.auth.token.erpRole == 'developer'
          || request.auth.token.erpRole == 'admin'
        );
    }

    // CONFIG altındakı digər sənədlər — bağlı
    match /config/{document=**} {
      allow read, write: if false;
    }

    // ŞİRKƏT DATA: tam izolasiya (şirkət sənədi + alt kolleksiyalar)
    match /companies/{companyId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.erp_session == true
        && request.auth.token.companyId is string
        && request.auth.token.companyId != ""
        && (
          request.auth.token.companyId == companyId
          || request.auth.token.role == 'developer'
        );
    }

    // DİGƏR: tam bağlı
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
